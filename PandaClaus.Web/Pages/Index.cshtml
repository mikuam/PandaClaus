@page
@using PandaClaus.Web.Core
@model IndexModel
@{
    ViewData["Title"] = "Panda Claus - Listy";
}

<!-- List Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-0 gx-5 mb-5 align-items-end">
            <div class="col-lg-12">
                <div class="text-center mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                    <div class="bg-light rounded p-4" id="campaign-countdown">
                        <p class="text-primary mb-2"><b id="countdown-title"></b></p>
                        <div class="d-flex justify-content-center gap-4 flex-wrap" id="countdown-values">
                            <div>
                                <span class="d-block h2 mb-0" id="countdown-days">0</span>
                                <small>dni</small>
                            </div>
                            <div>
                                <span class="d-block h2 mb-0" id="countdown-hours">0</span>
                                <small>godz.</small>
                            </div>
                            <div>
                                <span class="d-block h2 mb-0" id="countdown-minutes">0</span>
                                <small>min.</small>
                            </div>
                            <div>
                                <span class="d-block h2 mb-0" id="countdown-seconds">0</span>
                                <small>sek.</small>
                            </div>
                        </div>
                        <p class="mb-0 d-none" id="countdown-message"></p>
                    </div>
                </div>
                <div class="text-start mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                    <p>Drogi Pomocniku Panda Claus’a,</p>
                    <p>Oto przed Tobą lista z marzeniami naszych podopiecznych — wyjątkowych cichych bohaterów, którzy niosą na swoich barkach ogromny ciężar choroby lub utraty swojego rodzeństwa. To właśnie oni czekają na spełnienie swoich marzeń. Wierzymy, że dzięki Tobie się one spełnią. Twój prezent będzie niósł im radość w tym wyjątkowym czasie.</p>
                    <p><b>Jak przebiega akcja i jak możesz pomóc?</b></p>
                    <ol>
                        <li><b>Wybierz list</b> – możesz wybrać jeden lub kilka listów, a następnie spełnić dziecięce marzenie! Po kliknięciu zobaczysz krótki opis od rodziców dziecka oraz formularz rezerwacji. Kiedy go wypełnisz, otrzymasz na maila wszystkie techniczne informacje.</li>
                        <li><b>Kup prezent</b> – w liście każde dziecko podało swoje imię, wiek oraz wymarzony prezent, którego wartość nie powinna przekraczać 300 zł (oczywiście, to do Ciebie należy decyzja, ile pieniędzy przeznaczysz na prezent).</li>
                        <li><b>Dostarcz paczkę do Panda Claus’a</b> – wybrany przez Ciebie prezent należy dostarczyć najpóźniej do dnia 4 grudnia 2026 roku. Pamiętaj, aby prezent zmieścił się do <b>Paczkomatu InPost</b>. Szczegółowe informacje dotyczące wysyłki lub dostarczenia prezentów wyślemy do Ciebie e-mailem.</li>
                    </ol>
                    <p>Dodatkowe informacje znajdziesz na stronie <a asp-area="" asp-page="/SzczegolyAkcji">Szczegóły akcji</a>.</p>
                    <p><b>Partnerzy akcji:</b></p>
                </div>
                <div style="text-align: center;">
                    <img src="~/img/inpost_logo.png" class="m-3 m-lg-5" alt="InPost logo" />
                    <img src="~/img/grupa_mtp_logo.png" class="m-3 m-lg-5" alt="Grupa MTP logo" height="100" />
                    <img src="~/img/dudacars_logo.svg" class="m-3 m-lg-5" alt="Duda Cars logo" height="100" />
                    <img src="~/img/remondis_logo.svg" class="m-3 m-lg-5" alt="Remondis logo" height="100" />
                    <img src="~/img/bibliopunkt_logo.jpg" class="m-3 m-lg-5" alt="Bibliopunkt logo" height="100" />
                </div>
            </div>
        </div>
        <div class="col-lg-12 mb-5 text-center">
            <p>Listy czekające na pandowego Mikołaja: <strong>@Model.Letters.Count(l => l is { IsAssigned: false, IsVisible: true })</strong></p>
        </div>
        <div class="col-lg-12 mb-5 text-center">
            <a href="/?filter=all&search=@Request.Query["search"]" class="btn @Model.ButtonFiltersAll">Wszystkie</a>
            <a href="/?filter=available&search=@Request.Query["search"]" class="btn @Model.ButtonFiltersAvailable">Dostępne</a>
            <a href="/?filter=reserved&search=@Request.Query["search"]" class="btn @Model.ButtonFiltersReserved">Zarezerwowane</a>
        </div>

        <div class="col-lg-12 mb-3 text-center">
            <form method="get" action="/">
                <input type="text" name="search" class="form-control d-inline-block w-50" placeholder="Szukaj..." value="@Request.Query["search"]" />
                <button type="submit" class="btn btn-primary">Szukaj</button>
            </form>
        </div>

        <div class="tab-content">
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <div class="row g-4">
                    @foreach (var letter in Model.Letters)
                    {
                        <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                            <div class="property-item rounded overflow-hidden">
                                <div class="position-relative overflow-hidden letter-small-image">
                                    <a asp-area="" asp-page="/Letter" asp-route-hash="@letter.Hash">
                                        <img class="img-fluid" src="@letter.ImageThumbnailUrl" alt="letter image">
                                    </a>
                                    @if (letter.IsAssigned)
                                    {
                                        <div class="bg-primary rounded text-white position-absolute end-0 bottom-0 m-4 py-1 px-3 reserved">List zarezerwowany</div>
                                    }
                                    <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-3 py-1 px-3 number">@letter.Number</div>
                                </div>
                                <div class="p-4 pb-0">
                                    <a class="d-block h5 mb-2" asp-area="" asp-page="/Letter" asp-route-hash="@letter.Hash">@letter.ChildName<span>, </span><span>@letter.ChildAge.FormatAsAge()</span></a>
                                    <p>@letter.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const countdownElement = document.getElementById('campaign-countdown');
            if (!countdownElement) {
                return;
            }

            const titleElement = document.getElementById('countdown-title');
            const messageElement = document.getElementById('countdown-message');
            const valuesElement = document.getElementById('countdown-values');
            const daysElement = document.getElementById('countdown-days');
            const hoursElement = document.getElementById('countdown-hours');
            const minutesElement = document.getElementById('countdown-minutes');
            const secondsElement = document.getElementById('countdown-seconds');

            const milestones = [
                {
                    title: 'Do startu przyjmowania listów pozostało:',
                    target: new Date(2026, 9, 12, 0, 0, 0)
                },
                {
                    title: 'Do końca przyjmowania listów pozostało:',
                    target: new Date(2026, 9, 25, 23, 59, 59)
                },
                {
                    title: 'Do publikacji listów pozostało:',
                    target: new Date(2026, 10, 4, 0, 0, 0)
                },
                {
                    title: 'Do zakończenia finału akcji pozostało:',
                    target: new Date(2026, 11, 6, 0, 0, 0)
                }
            ];

            const showMessage = (message) => {
                titleElement.textContent = 'Panda Claus 2026';
                valuesElement.classList.add('d-none');
                messageElement.textContent = message;
                messageElement.classList.remove('d-none');
            };

            const updateCountdown = () => {
                const now = new Date();
                const milestone = milestones.find(item => now < item.target);

                if (!milestone) {
                    showMessage('Finał akcji już się zakończył. Dziękujemy za wzięcie udziału i zapraszamy za rok!');
                    return false;
                }

                const distance = milestone.target.getTime() - now.getTime();
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
                const minutes = Math.floor((distance / (1000 * 60)) % 60);
                const seconds = Math.floor((distance / 1000) % 60);

                titleElement.textContent = milestone.title;
                daysElement.textContent = days.toString();
                hoursElement.textContent = hours.toString().padStart(2, '0');
                minutesElement.textContent = minutes.toString().padStart(2, '0');
                secondsElement.textContent = seconds.toString().padStart(2, '0');

                return true;
            };

            const shouldContinue = updateCountdown();
            if (!shouldContinue) {
                return;
            }

            const interval = window.setInterval(() => {
                if (!updateCountdown()) {
                    window.clearInterval(interval);
                }
            }, 1000);
        })();
    </script>
}
