@page
@model LetterFormModel
@inject PandaClaus.Web.Services.FeatureFlags FeatureFlags
@{
    ViewData["Title"] = "Dodaj List";
}

@section HeaderJS {
    <link rel="stylesheet" href="https://geowidget.inpost.pl/inpost-geowidget.css" />
    <script src='https://geowidget.inpost.pl/inpost-geowidget.js' defer></script>
    <script>
        console.log('added event listener');
        document.addEventListener('onpointselect', (event) => {
            console.log('Selected point: ', event.detail.name);
            document.getElementById('paczkomatCode').value = event.detail.name;
            // Close the modal after selection
            var modal = bootstrap.Modal.getInstance(document.getElementById('geowidgetModal'));
            if (modal) {
                modal.hide();
            }
        });
    </script>
    <style>
        #geowidgetModal .modal-dialog {
            max-width: 90%;
            width: 900px;
        }

        #geowidgetModal inpost-geowidget {
            height: 600px;
            display: block;
        }
    </style>
}

<div class="container-xxl bg-white p-0">
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="mt-4 mb-4">Panda Claus 2026</h1>
                    <p><b>Panda Claus powraca! Nadchodzi wielkimi krokami i zbiera listy od dzieci, które go wyczekują.</b></p>
                    <p><b>Rodzicu, zanim wypełnisz formularz, przeczytaj poniższe informacje.</b></p>
                    <p>Pandowy Święty Mikołaj i jego elfy chcą spełnić świąteczne marzenia dzieci, które przeżywają stratę mamy, taty, brata, siostry lub opiekuna prawnego. Chcemy, by magia świąt dotarła również do nich.</p>
                    <p><b>Jak wziąć udział w akcji?</b></p>
                    <p>Rodzic lub opiekun prawny może zgłosić dziecko, które w dniu zgłoszenia nie ukończyło 18 lat, jeśli od śmierci mamy, taty, brata, siostry lub opiekuna prawnego nie upłynęły więcej niż 2 lata. Dla każdego dziecka należy wypełnić osobny <a href="https://pandaclaus.pl/LetterForm">formularz zgłoszeniowy</a>.</p>
                    <p class="text-danger"><strong>Uwaga:</strong> Sama choroba, również onkologiczna, nie jest podstawą do udziału w tej edycji.</p>
                    <p><b>Rodzicu, to ważne informacje dla Ciebie!</b> Każde dziecko prosimy o napisanie listu do Panda Clausa (Pandowego Świętego Mikołaja), w którym opowie o swoim wymarzonym prezencie (wartość do 300 zł). List musi być napisany ręcznie, a jeśli dziecko nie potrafi jeszcze pisać lub ma z tym trudności, możesz mu w tym pomóc. Dekorowanie listu zostaw dziecku — na pewno świetnie sobie poradzi.  Listy pisane na komputerze nie będą przyjmowane. </p>
                    <p>Gotowy list zeskanuj i prześlij za pomocą formularza zgłoszeniowego na stronie akcji <a href="https://pandaclaus.pl/LetterForm">https://pandaclaus.pl/LetterForm</a></p>
                    <p><b>Kilka ważnych zasad:</b></p>
                    <ol>
                        <li>Wartość prezentu wskazanego w liście dla jednego dziecka nie może przekraczać 300 zł.</li>
                        <li>Prezent wskazany w liście powinien być takich wymiarów, aby można było go wysłać <b>Paczkomatem InPost</b>, który jest naszym Partnerem wysyłkowym.</li>
                        <li>Listy <b>nie mogą zawierać innych danych osobowych</b> dziecka poza imieniem i wiekiem.</li>
                        <li>Prezentem nie mogą być żywe zwierzęta.</li>
                    </ol>
                    <p>Pozostałe zasady udziału znajdziesz w <a href="/Privacy">regulaminie akcji</a>.</p>
                    <p><b>Kiedy wysyłać zgłoszenia?</b></p>
                    <p>Zgłoszenia przyjmujemy do 2 listopada 2026 r. do godziny 23:59. W razie potrzeby termin może ulec zmianie. Panda Claus dołoży wszelkich starań, aby prezenty trafiły do dzieci jeszcze przed Świętami – do 24 grudnia 2026 r.</p>
                    <p>Listy napisane przez dzieci, zostaną udostępnione na naszych kanałach w mediach społecznościowych oraz na stronie akcji. Darczyńcy akcji będą mogli wybrać listy od dzieci, dla których przygotują podarunki.</p>

                    <p>Wszystkie pytania prosimy kierować na adres: <a href="mailto:pandaclaus@pandateam.pl">pandaclaus@pandateam.pl</a></p>
                </div>
            </div>
        </div>
        <hr class="mb-4" />

        @if (!Model.IsAdmin && !FeatureFlags.AddLetterLinkVisible)
        {
            <div class="container col-lg-6 offset-lg-3">
                <div class="alert alert-info text-center" role="alert">
                    <i class="fa fa-info-circle me-2"></i>
                    <p class="mb-0"><b>Przyjmowanie zgłoszeń w Panda Claus 2026 zostało już zakończone.</b></p>
                </div>
            </div>
        }
        else
        {
            @* Form visible only for admins *@
            <div class="container col-lg-6 offset-lg-3">
                <h2 class="h4 mb-4">Formularz zgłoszeniowy</h2>
            </div>
            <form method="post" enctype="multipart/form-data" novalidate>
                <div class="container col-lg-6 offset-lg-3 clearfix">
                    @if (!ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row mb-4">
                        <div class="mb-6">
                            <label asp-for="ParentName">Imię rodzica/opiekuna prawnego <span class="text-danger">*</span></label>
                            <input asp-for="ParentName" type="text" class="form-control" id="parentName" required>
                        </div>
                        <div class="mb-6">
                            <label asp-for="ParentSurname">Nazwisko rodzica/opiekuna prawnego <span class="text-danger">*</span></label>
                            <input asp-for="ParentSurname" type="text" class="form-control" id="parentSurname" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber">Numer telefonu rodzica/opiekuna prawnego <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" id="phoneNumber"
                               pattern="[4-8][0-9]{8}"
                               placeholder="np. 501234567"
                               maxlength="9"
                               required>
                        <div class="form-text">Podaj 9-cyfrowy numer telefonu bez kierunkowego +48 (np. 501234567)</div>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Email">Adres e-mail rodzica/opiekuna prawnego <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" id="email" required>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Street">Ulica <span class="text-danger">*</span></label>
                            <input asp-for="Street" type="text" class="form-control" id="street" required>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="HouseNumber">Numer domu <span class="text-danger">*</span></label>
                            <input asp-for="HouseNumber" type="text" class="form-control" id="houseNumber" required>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ApartmentNumber">Numer lokalu</label>
                            <input asp-for="ApartmentNumber" type="text" class="form-control" id="apartmentNumber">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="City">Miasto<span class="text-danger">*</span></label>
                        <input asp-for="City" type="text" class="form-control" id="city" required>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PostalCode">Kod pocztowy (format: XX-XXX)<span class="text-danger">*</span></label>
                        <input asp-for="PostalCode" type="text" class="form-control" id="postalCode" pattern="[0-9]{2}-[0-9]{3}" required>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PaczkomatCode">Kod paczkomatu InPost <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="PaczkomatCode" type="text" class="form-control" id="paczkomatCode" pattern="([A-Z]{3,4}[0-9]{2,3}[A-Z]{1,3}|POP-[A-Z]{3}[0-9]{0,4})" required>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#geowidgetModal">
                                <i class="fa fa-map-marker-alt me-2"></i>Wybierz na mapie
                            </button>
                        </div>
                        <div class="form-text">Kod paczkomatu znajdziesz na stronie: <a href="https://inpost.pl/znajdz-paczkomat" target="_blank">Paczkomaty InPost</a> lub kliknij przycisk "Wybierz na mapie"</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ChildName">Imię dziecka zgłaszanego do akcji (Jeżeli dodajesz kilkoro dzieci, dodaj je osobno)<span class="text-danger">*</span></label>
                        <input asp-for="ChildName" type="text" class="form-control" id="childName" required>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ChildAge">Wiek dziecka zgłaszanego do akcji <span class="text-danger">*</span></label>
                        <input asp-for="ChildAge" type="number" class="form-control" id="childAge" min="0" max="18" required>
                    </div>
                    <div class="mb-4">
                        <label asp-for="DeceasedRelation">Kogo straciło dziecko? <span class="text-danger">*</span></label>
                        <select asp-for="DeceasedRelation" class="form-select" required>
                            <option value="">Wybierz odpowiedź</option>
                            <option value="Mama">Mamę</option>
                            <option value="Tata">Tatę</option>
                            <option value="Brat">Brata</option>
                            <option value="Siostra">Siostrę</option>
                            <option value="Opiekun prawny">Opiekuna prawnego</option>
                        </select>
                        <span asp-validation-for="DeceasedRelation" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="LossTime">Kiedy zmarła ta osoba? <span class="text-danger">*</span></label>
                        <input asp-for="LossTime" type="text" class="form-control" inputmode="numeric"
                               placeholder="np. 05.2025 lub 2025" pattern="([0][1-9]|1[0-2])\.[0-9]{4}|[0-9]{4}" required>
                        <span asp-validation-for="LossTime" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description">Opiszcie krótko swoją historię i z jakiego powodu bierzecie udział w akcji. Ta treść będzie widoczna na stronie z listem i będzie zachęcała Darczyńców do jego realizacji. <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" rows="3" class="form-control" id="description" required></textarea>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Presents">Opisz listę prezentów, o które prosi dziecko<span class="text-danger">*</span></label>
                        <textarea asp-for="Presents" rows="3" class="form-control" id="presents" required></textarea>
                    </div>
                    <div class="mb-4">
                        <label asp-for="LetterPhotos">Wyślij skan lub zdjęcie listu <span class="text-danger">*</span></label>
                        <input asp-for="LetterPhotos" type="file" class="form-control" id="file" accept=".jpg, .png, .jpeg, .bmp, .tif, .tiff" required multiple>
                    </div>

                    <p class="mt-4 mb-2"><span class="text-danger">*</span> oznacza pole obowiązkowe</p>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="selectAllConsents">
                        <label class="form-check-label" for="selectAllConsents">
                            <b>Zaznacz wszystkie zgody</b>
                        </label>
                    </div>
                    
                    <div class="form-check mb-4">
                        <input asp-for="ConfirmParentStatement" class="form-check-input consent-checkbox" type="checkbox" id="confirmParentStatement" required>
                        <label class="form-check-label" asp-for="ConfirmParentStatement">
                            <span class="text-danger">*</span> Oświadczam, że jestem rodzicem lub opiekunem prawnym zgłaszanego dziecka, a informacje podane w formularzu są zgodne z moją najlepszą wiedzą ze stanem faktycznym.
                        </label>
                        <span asp-validation-for="ConfirmParentStatement" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AcceptRegulamin" class="form-check-input consent-checkbox" type="checkbox" id="acceptRegulamin" required>
                        <label class="form-check-label" asp-for="AcceptRegulamin">
                            <span class="text-danger">*</span> Zapoznałam/em się z <a href="https://pandaclaus.pl/Privacy" target="_blank">Regulaminem Akcji Panda Claus 2026</a> i akceptuję jego postanowienia.
                        </label>
                        <span asp-validation-for="AcceptRegulamin" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AcceptRodoClause" class="form-check-input consent-checkbox" type="checkbox" id="acceptRodoClause" required>
                        <label class="form-check-label" asp-for="AcceptRodoClause">
                            <span class="text-danger">*</span> Zapoznałam/em się z <a asp-page="/KlauzulaRodo" target="_blank" rel="noopener noreferrer">Klauzulą informacyjną RODO</a> dotyczącą Akcji Panda Claus 2026.
                        </label>
                        <span asp-validation-for="AcceptRodoClause" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="ConsentToPublication" class="form-check-input consent-checkbox" type="checkbox" id="consentToPublication" required>
                        <label class="form-check-label" asp-for="ConsentToPublication">
                            <span class="text-danger">*</span> Wyrażam zgodę na publikację imienia i wieku dziecka, zdjęcia lub skanu jego listu oraz przygotowanego do publikacji opisu jego historii na stronie Akcji Panda Claus oraz w oficjalnych kanałach Fundacji Panda Team w celu przeprowadzenia i informowania o Akcji. Wyrażam również zgodę na niezbędne wykorzystanie i opracowanie listu, w szczególności jego kadrowanie, zmianę rozmiaru, poprawę jakości, zasłanianie danych oraz umieszczanie w oprawie graficznej Akcji.
                        </label>
                        <span asp-validation-for="ConsentToPublication" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="ConsentToContact" class="form-check-input consent-checkbox" type="checkbox" id="consentToContact" required>
                        <label class="form-check-label" asp-for="ConsentToContact">
                            <span class="text-danger">*</span> Przyjmuję do wiadomości, że Fundacja Panda Team będzie kontaktować się ze mną na podany w formularzu adres e-mail i/lub numer telefonu w sprawach związanych z Akcją Panda Claus 2026, w szczególności dotyczących statusu zgłoszenia, jego weryfikacji, realizacji listu, wysyłki prezentu oraz ewentualnych problemów wymagających kontaktu.
                        </label>
                        <span asp-validation-for="ConsentToContact" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="ConsentToNewsletter" class="form-check-input consent-checkbox" type="checkbox" id="consentToNewsletter">
                        <label class="form-check-label" asp-for="ConsentToNewsletter">
                            Chcę otrzymywać na podany adres e-mail newsletter Fundacji Panda Team z informacjami o działaniach Fundacji, dostępnych formach wsparcia, wydarzeniach i kolejnych inicjatywach. Zgodę mogę wycofać w każdym czasie.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary py-3 px-5 mt-3 float-end">Wyślij</button>
                </div>
            </form>

            <script>
                (function () {
                    var form = document.querySelector('form[method="post"][enctype="multipart/form-data"]');
                    if (!form) return;

                    function getMessage(field) {
                        var validity = field.validity;
                        if (validity.customError) return field.validationMessage;
                        if (validity.valueMissing) return 'To pole jest wymagane.';
                        if (validity.typeMismatch) return 'Wprowadzona wartość ma nieprawidłowy format.';
                        if (validity.patternMismatch) return 'Wprowadzona wartość ma nieprawidłowy format.';
                        if (validity.tooShort) return 'Wprowadzona wartość jest za krótka.';
                        if (validity.tooLong) return 'Wprowadzona wartość jest za długa.';
                        if (validity.rangeUnderflow || validity.rangeOverflow) return 'Wprowadzona wartość jest poza dozwolonym zakresem.';
                        return 'Wprowadzona wartość jest nieprawidłowa.';
                    }

                    function clearError(field) {
                        field.classList.remove('is-invalid');
                        var feedback = field.parentElement.querySelector('.invalid-feedback-pl');
                        if (feedback) {
                            feedback.remove();
                        }
                    }

                    function showError(field, message) {
                        field.classList.add('is-invalid');
                        var feedback = field.parentElement.querySelector('.invalid-feedback-pl');
                        if (!feedback) {
                            feedback = document.createElement('div');
                            feedback.className = 'invalid-feedback-pl text-danger small mt-1';
                            field.insertAdjacentElement('afterend', feedback);
                        }
                        feedback.textContent = message;
                    }

                    var lossTime = form.querySelector('input[name="LossTime"]');
                    function checkLossTime() {
                        if (!lossTime) return;
                        lossTime.setCustomValidity('');
                        var value = lossTime.value;
                        if (!/^(?:[0-9]{4}|(?:0[1-9]|1[0-2])\.[0-9]{4})$/.test(value)) return;
                        var parts = value.split('.');
                        var year = Number(parts[parts.length - 1]);
                        var month = parts.length === 2 ? Number(parts[0]) : null;
                        var todayParts = new Intl.DateTimeFormat('en-GB', {
                            timeZone: 'Europe/Warsaw', year: 'numeric', month: '2-digit', day: '2-digit'
                        }).formatToParts(new Date());
                        var get = function (name) { return Number(todayParts.find(function (part) { return part.type === name; }).value); };
                        var todayYear = get('year'), todayMonth = get('month');
                        if (year < todayYear - 2 || year > todayYear ||
                            (year === todayYear && month !== null && month > todayMonth)) {
                            lossTime.setCustomValidity('Podaj bieżący rok lub jeden z dwóch poprzednich lat. Miesiąc nie może być w przyszłości.');
                        }
                    }

                    var fields = form.querySelectorAll('input, textarea, select');
                    fields.forEach(function (field) {
                        field.addEventListener('input', function () {
                            clearError(field);
                            if (field === lossTime) checkLossTime();
                        });
                        field.addEventListener('change', function () {
                            clearError(field);
                            if (field === lossTime) checkLossTime();
                        });
                    });

                    form.addEventListener('submit', function (e) {
                        var firstInvalid = null;
                        checkLossTime();

                        fields.forEach(function (field) {
                            clearError(field);
                            if (!field.checkValidity()) {
                                showError(field, getMessage(field));
                                if (!firstInvalid) {
                                    firstInvalid = field;
                                }
                            }
                        });

                        if (firstInvalid) {
                            e.preventDefault();
                            firstInvalid.focus();
                        }
                    });

                    var selectAll = document.getElementById('selectAllConsents');
                    var consentCheckboxes = form.querySelectorAll('.consent-checkbox');

                    if (selectAll) {
                        selectAll.addEventListener('change', function () {
                            consentCheckboxes.forEach(function (checkbox) {
                                checkbox.checked = selectAll.checked;
                                clearError(checkbox);
                            });
                        });

                        function syncSelectAll() {
                            var allChecked = Array.prototype.every.call(consentCheckboxes, function (checkbox) {
                                return checkbox.checked;
                            });
                            selectAll.checked = allChecked;
                        }

                        consentCheckboxes.forEach(function (checkbox) {
                            checkbox.addEventListener('change', syncSelectAll);
                        });
                    }
                })();
            </script>
        }

        <hr class="mt-5 mb-4" />
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <p><b>Partnerzy akcji:</b></p>
                    <div style="text-align: center;">
                        <img src="~/img/inpost_logo.png" class="m-3 m-lg-5" alt="InPost logo" height="100" style="max-width: calc(100% - 2rem); object-fit: contain;" />
                        <img src="~/img/dudacars_logo.svg" class="m-3 m-lg-5" alt="Duda Cars logo" height="100" />
                        <img src="~/img/top_party_box_logo.png" class="m-3 m-lg-5" alt="Top Party Box" height="100" />
                        <img src="~/img/bibliopunkt_logo.jpg" class="m-3 m-lg-5" alt="Bibliopunkt logo" height="100" style="max-width: calc(100% - 2rem); object-fit: contain;" />
                        <img src="~/img/malta_festival_logo.png" class="m-3 m-lg-5" alt="Malta Festival logo" style="max-width: calc(100% - 2rem); max-height: 45px; width: auto; height: auto; object-fit: contain;" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- InPost Geowidget Modal -->
<div class="modal fade" id="geowidgetModal" tabindex="-1" aria-labelledby="geowidgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="geowidgetModalLabel">
                    <i class="fa fa-map-marker-alt me-2"></i>Wybierz Paczkomat InPost
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <inpost-geowidget language='pl' config='parcelcollect' onpoint="onpointselect"
                                  token='@Model.InPostGeoWidgetToken'></inpost-geowidget>
            </div>
        </div>
    </div>
</div>
